# Copier vers .env en local (ne pas committer .env)

SECRET_KEY=change-me-in-production
DJANGO_DEBUG=true
ALLOWED_HOSTS=localhost,127.0.0.1

# CORS — origines Flutter web (séparées par des virgules)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080

# SQLite (défaut local) — laisser DATABASE_URL et DB_ENGINE vides

# PostgreSQL (optionnel en local, ou copier l’Internal Database URL depuis Render)
# DATABASE_URL=postgres://user:pass@host:5432/chezwizi

# Cloudinary (images produits — recommandé même en local pour tester comme la prod)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
